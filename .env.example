# Copy to .env. Set POSTGRES_PASSWORD to a random local value before starting.
POSTGRES_DB=bec_guard
POSTGRES_USER=bec_guard
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Compose overrides POSTGRES_HOST with the postgres service name for the backend.
POSTGRES_HOST=localhost
BACKEND_PORT=8000
FRONTEND_PORT=5173
N8N_PORT=5678
GENERIC_TIMEZONE=America/Lima

# Required by the web API; generate a random key of at least 32 characters locally.
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_MINUTES=30
JWT_ALGORITHM=HS256

# Scoped backend automation endpoints only. Generate a random key >=32 characters.
AUTOMATION_API_KEY=
# Used by the n8n importer to configure its HTTP nodes; Docker-internal URL.
BEC_GUARD_BACKEND_URL=http://backend:8000

# Backend semantic analysis only; optional until POST /api/emails/{id}/analyze.
# LLM_PROVIDER: openai, google (or gemini), groq. Model must support native JSON schema.
LLM_PROVIDER=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
OPENAI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
