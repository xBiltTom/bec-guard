# Copy to .env. Set POSTGRES_PASSWORD to a random local value before starting.
POSTGRES_DB=bec_guard
POSTGRES_USER=bec_guard
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Compose overrides POSTGRES_HOST with the postgres service name for the backend.
POSTGRES_HOST=localhost
BACKEND_PORT=8000
FRONTEND_PORT=5173
N8N_PORT=5678
GENERIC_TIMEZONE=America/Lima

# Future configuration only. Not used or forwarded to the frontend in Phase 1.
LLM_PROVIDER=
LLM_MODEL=
OPENAI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
